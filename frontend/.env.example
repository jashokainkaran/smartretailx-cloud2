# These identifiers are public browser configuration, not passwords or AWS keys.
VITE_COGNITO_DOMAIN=https://smartretailx-dev-jashok.auth.eu-west-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=446p56998av63mo3j5gg63u774
VITE_API_BASE_URL=https://d1vxg10hlsklfv.cloudfront.net

# The WebSocket API's connection URL (CP-020) — a separate endpoint from
# VITE_API_BASE_URL; API Gateway does not let an HTTP API and a WebSocket
# API share one gateway. `terraform output websocket_url` prints the current
# value.
VITE_WS_BASE_URL=wss://5qxdlljvh0.execute-api.eu-west-1.amazonaws.com/prod

# Optional. When absent, the app uses the address currently open in the browser.
# That works for both http://localhost:5173 and the deployed CloudFront site,
# because both addresses are registered callback/logout URLs in Cognito.
# VITE_COGNITO_REDIRECT_URI=http://localhost:5173
