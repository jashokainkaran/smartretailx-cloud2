# Python
venv/
__pycache__/
*.pyc
.pytest_cache/

# Environment / secrets
.env
*.env

# Node / frontend
node_modules/
dist/
.vite/
.pnpm-store/

# Terraform — state contains resource attributes in plaintext, never commit
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*

# tfvars may contain sensitive values; allow the safe ones explicitly
*.tfvars
!dev.tfvars
!example.tfvars

# OS / editor junk
.DS_Store
.idea/
.vscode/

# Internal planning docs (excluded by choice) — docs/api/ is real API
# documentation, not a planning note, so it's carved out and tracked.
docs/*
!docs/api/

# Evidence screenshots/logs for the report — excluded by choice
evidence/

# Local tooling scratch data — not project content
.playwright-mcp/

# Local record used to prevent the deployed test-order script repeating a run
scripts/.seed-state/
