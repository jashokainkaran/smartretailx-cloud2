# Terraform state — contains resource IDs and can contain secrets. NEVER commit.
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
cognito-post-confirmation.zip

# Variable files may contain sensitive values
*.tfvars
!example.tfvars

# Saved plan files are local working artifacts, not source
tfplan*

# Backend configuration is machine/environment specific. The committed
# backend.hcl.example documents the non-secret shape used by local and CI/CD.
backend.hcl
