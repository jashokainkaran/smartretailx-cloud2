    "/api/v1/products/{product_id}/activate": {
      "patch": {
        "summary": "Activate Product",
        "description": "Reactivate a previously deactivated product.",
        "operationId": "activate_product_api_v1_products__product_id__activate_patch",
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
